# the two tracks (PLAY: the drums, SEQ: the sequence), a loop recorded with REC, kept after a restart, cleared
# by holding REC; the count-in before it; the voices (the Play and Voices pages)
wait 200
turn SELECT 4 200
expect par5 120
# the sequence alone: no drums
tap SEQ
expect seq 1
expect drums 0
expect playing 1
# the drums join; the sequence stops; the drums go on
tap PLAY
expect drums 1
tap SEQ
wait 20
expect seq 0
expect playing 1
tap PLAY
wait 20
expect playing 0
# a loop of one bar (Rhythm page, GLO: Bars 1): REC starts the sequence with four beats counted in (2 s at
# 120), then records: C for half the bar, then A minor
tap GLO
expect view 2
spin K3 -1
expect par24 0
key b1 down
tap REC
expect rec 4
expect count 1
expect seq 1
wait 600
expect count 2
shot countin.png
wait 1400
expect rec 2
expect step <2
wait 900
key b1 up
key b4 down
wait 300
shot recording.png
wait 900
key b4 up
expect rec 0
expect looplen 16
# played back: no button held, the loop's chords, held
wait 400
expect chordroot 0
expect gen 1
expect chord_level >50
shot loop.png
wait 1000
expect chordroot 9
# stopped, it saves by itself, and comes back after a restart
tap SEQ
wait 5000
expect dirty 0
reboot
wait 100
expect looplen 16
# playing again (from the top: C)
tap SEQ
wait 200
expect chordroot 0
tap SEQ
wait 20
# REC held a second clears it
press REC
wait 1100
release REC
wait 20
expect looplen 0
expect rec 0
# the voices: the harp's model on the Play page (KNOB 1, the page after a restart), the chord's on Voices
# (FX twice)
expect view 0
spin K1 1
expect par16 2
strum 0 15 20
wait 200
shot modal.png
spin K1 -2
expect par16 0
wait 50
shot om84.png
tap FX
tap FX
expect view 5
spin K1 2
expect par20 4
key b2 down
wait 300
expect chord_level >50
key b2 up
wait 50
shot voices.png
