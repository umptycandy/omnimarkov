# chord buttons, LFO for the 7th, SHIFT (ENV), CHORD HOLD, SYNC START, saving
wait 200
# F (button 0); LFO held: F7
tapkey b0
expect root 5
expect type 0
press LFO
tapkey b0
release LFO
expect type 2
# SHIFT (ENV) and a black key: the button picked for the Chords page, nothing played (still F7)
press ENV
tapkey b4
release ENV
expect root 5
expect type 2
expect pad -1
# a modifier used with a chord does not open its page
expect view 0
# the strings follow the chord: F7 is F A Eb, F3 A3 Eb3 on strings 0..2 (Eb folded up to F#2..F3)
tapkey b0
press LFO
tapkey b0
release LFO
expect strnote0 53
expect strnote1 45
expect strnote2 51
# without HOLD the chord stops when let go
tapkey b1
wait 400
expect chord_level 0
# CHORD HOLD: it keeps going; the same button again stops it
tap ARP
expect hold 1
tapkey b2
wait 400
expect chord_level >50
expect pad 2
tapkey b2
wait 400
expect chord_level 0
expect pad -1
tap ARP
expect hold 0
# SYNC START (the Setup page, GLO twice): PLAY and SEQ wait for a chord, and start with it
tap GLO
tap GLO
expect view 6
spin K4 1
expect sync 1
tap PLAY
tap SEQ
expect armed 3
expect playing 0
wait 100
key b3 down
wait 20
expect playing 1
expect armed 0
key b3 up
tap PLAY
expect playing 1
tap SEQ
wait 20
expect playing 0
tap HOME
# OCT+ moves the plate up
tap OCT+
expect par13 1
tap OCT-
expect par13 0
# transpose with PRESETS: +2
turn PRESET 2
expect par12 2
# the CHORDS page: press a button, change its chord
tap SEL
expect view 3
tapkey b10
spin K1 -2
spin K2 -2
expect padroot10 7
expect padtype10 0
shot chords.png
# it saves by itself when quiet, and comes back after a restart
wait 5000
expect dirty 0
reboot
wait 100
expect padroot10 7
expect par12 2
expect sync 1
shot after_reboot.png
# Chord rev comes back at its default
expect par11 25
# a project saved by 0.2 (format 2) loads: its values kept, Auto bass gone (that slot is Swing now), the
# new voices at their defaults
oldproject
reboot
wait 100
expect par3 40
expect par7 0
expect par16 1
expect padroot0 2
expect padtype0 1
expect hold 1
# SHIFT's layer: the Play page's knobs become Velocity, Position, LPG color while ENV is held
press ENV
spin K1 -30
release ENV
expect par25 50
spin K1 1
expect par16 2
# SHIFT + PLAY: both tracks at once; SHIFT + SEQ: from the top
press ENV
tap PLAY
release ENV
expect drums 1
expect seq 1
wait 1000
press ENV
tap SEQ
release ENV
wait 20
expect step <2
press ENV
tap PLAY
release ENV
wait 20
expect playing 0
